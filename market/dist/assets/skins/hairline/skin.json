        "src": "assets/water-line-dark.mp4",
        "scrim": "linear-gradient(180deg, rgba(5,14,11,0.46) 0%, rgba(5,14,11,0.20) 26%, rgba(5,14,11,0.10) 58%, rgba(5,14,11,0.44) 100%)"
      },
      "dark": {
        "type": "video",
        "src": "assets/water-line-dark.mp4",
